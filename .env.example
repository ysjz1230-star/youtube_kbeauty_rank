# 값은 Vercel 프로젝트 설정(Production/Preview/Development)에 등록한다. 이 파일에는 이름만 적는다.
YOUTUBE_API_KEY=
DATABASE_URL=
CRON_SECRET=
SITE_URL=http://localhost:3000
INGEST_ENABLED=false
INGEST_CHUNK_SIZE=100
QUOTA_SOFT_LIMIT=8000
RETENTION_DAYS=30
MIN_BASE_SUBSCRIBERS=10000
# 승인(III.L) 후에만 true: 증가 보드·순위 변동 활성화
FEATURE_DERIVED_METRICS=false
# 개발용: 1이면 XSS 이스케이프 확인용 목업 채널을 포함한다
MOCK_XSS=0

# 배포 환경(Vercel)에서도 /dev/status 점검 화면을 열려면 true (기본: 로컬에서만 열림)
# DIAGNOSTICS_ENABLED=false
